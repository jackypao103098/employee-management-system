{
  "Application": {
    "Name": "Employee Management API",
    "Version": "1.0.0"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "EmployeeManagement.Api",
    "Audience": "EmployeeManagement.React",
    "ExpirationMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
